---
import Layout from "../layouts/Layout.astro";

const description = "The consulting practice of Brent Fitzgerald";
---

<Layout title="MONO KOTO" description={description}>
  <article class="box">
    <div class="space-y-[1.5rem]">
      <div>
        <h1>Mono Koto</h1>
      </div>

      <p>
        Mono Koto is the consulting practice of{" "}
        <a href="https://brentfitzgerald.com">Brent Fitzgerald</a>.
      </p>

      <p>
        From the Japanese <strong>mono</strong> (object thing) and{" "}
        <strong>koto</strong> (concept thing), <span class="text-nowrap"
          >Mono Koto</span
        >
        creates digital objects with conceptual heft.
      </p>

      <p>
        For current work and background, see{" "}
        <a href="https://brentfitzgerald.com">brentfitzgerald.com</a>.
      </p>

      <div>
        <p>
          Get in touch:{" "}
          <a href="mailto:info@mono-koto.com">info@mono-koto.com</a>
        </p>
      </div>
    </div>
  </article>
</Layout>
